# Application
PROJECT_NAME="AI-Powered Career Path Recommendation System"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT
SECRET_KEY=your-super-secret-jwt-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL (production/docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_db
# For SQLite (local testing / standalone zero-dependency run):
DATABASE_URL=sqlite:///./career_recommendation.db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Optional LLM Integration
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Scoring Profile
DEFAULT_SCORING_PROFILE_PATH=data/scoring_profiles/default_weights.json
CAREERS_DATA_PATH=data/careers/careers_dataset.json
